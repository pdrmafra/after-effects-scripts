PedroAE.run("Stepped Keyframes", function () {
    var comp = PedroAE.comp();
    var win = new Window("dialog", "Stepped Keyframes");
    win.orientation = "column";
    win.alignChildren = ["fill", "top"];
    var row = win.add("group");
    row.add("statictext", undefined, "Sample interval (whole frames):");
    var input = row.add("edittext", undefined, "2");
    input.characters = 6;
    var hold = win.add("checkbox", undefined, "Hold between samples (changes interpolation inside chosen intervals)");
    win.add("statictext", undefined, "Select two or more keys. Existing keys are kept; values are sampled before any changes.");
    var buttons = win.add("group");
    var apply = buttons.add("button", undefined, "Apply");
    buttons.add("button", undefined, "Cancel", { name: "cancel" });
    apply.onClick = function () {
        try { PedroAE.step(comp, input.text, hold.value); win.close(1); }
        catch (error) { alert(error.toString()); }
    };
    win.center();
    win.show();
});
