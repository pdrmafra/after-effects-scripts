var PedroStrokeFixtures = (function () {
    function toShape(data) {var s=new Shape();s.vertices=data.vertices;s.inTangents=data.inTangents;s.outTangents=data.outTangents;s.closed=data.closed;return s;}
    function source(comp,name,parametric,rounded,angle,nested,options) {
        options=options || {};
        var layer=comp.layers.addShape();layer.name=name;
        var contents=layer.property("ADBE Root Vectors Group"),chain=[];
        var outer=contents.addProperty("ADBE Vector Group");outer.name="Imported outline";chain.push(outer.propertyIndex);
        if(nested) {
            outer.property("ADBE Vector Transform Group").property("ADBE Vector Rotation").setValue(17);
            outer.property("ADBE Vector Transform Group").property("ADBE Vector Scale").setValue(options.mirror ? [-120,80] : [120,80]);
            var inner=outer.property("ADBE Vectors Group").addProperty("ADBE Vector Group");inner.name="Nested";chain.push(inner.propertyIndex);
        }
        contents=PedroStrokeHost.contentsAt(layer,chain);
        if(parametric) {
            var rect=contents.addProperty("ADBE Vector Shape - Rect");
            var size=options.size || [200,20];
            rect.property("ADBE Vector Rect Size").setValue(size);
            rect.property("ADBE Vector Rect Position").setValue(options.center || [10,-5]);
            rect.property("ADBE Vector Rect Roundness").setValue(typeof options.roundness==="number" ? options.roundness : (rounded ? Math.min(size[0],size[1])/2 : 0));
            var group=layer.property("ADBE Root Vectors Group").property(chain[0]);
            group.property("ADBE Vector Transform Group").property("ADBE Vector Rotation").setValue(angle);
        } else {
            var path=contents.addProperty("ADBE Vector Shape - Group");
            path.property("ADBE Vector Shape").setValue(toShape(options.data || PedroStrokeGeometry.fixture(200,20,rounded,angle,[10,-5])));
            if(options.extraPath) {
                var extra=PedroStrokeHost.contentsAt(layer,chain).addProperty("ADBE Vector Shape - Group");
                extra.property("ADBE Vector Shape").setValue(toShape(options.extraPath));
            }
        }
        var fill=PedroStrokeHost.contentsAt(layer,chain).addProperty("ADBE Vector Graphic - Fill");
        fill.property("ADBE Vector Fill Color").setValue([0.1,0.7,0.9,1]);
        fill.property("ADBE Vector Fill Opacity").setValue(73);
        if(options.fillRule) fill.property("ADBE Vector Fill Rule").setValue(options.fillRule);
        return {layer:layer,chain:chain};
    }
    function reverse(data) {var incoming=data.inTangents;data.vertices.reverse();data.inTangents=data.outTangents.reverse();data.outTangents=incoming.reverse();return data;}
    function straight(points) {
        var data={vertices:points,inTangents:[],outTangents:[],closed:true};
        for(var i=0;i<points.length;i++){data.inTangents.push([0,0]);data.outTangents.push([0,0]);}return data;
    }
    function ellipse(width,height) {
        var x=width/2,y=height/2,k=0.5522847498307936;
        return {vertices:[[0,-y],[x,0],[0,y],[-x,0]],inTangents:[[-k*x,0],[0,-k*y],[k*x,0],[0,k*y]],outTangents:[[k*x,0],[0,k*y],[-k*x,0],[0,-k*y]],closed:true};
    }
    function translate(data,center) {for(var i=0;i<data.vertices.length;i++){data.vertices[i][0]+=center[0];data.vertices[i][1]+=center[1];}return data;}
    function band(ro,ri,start,sweep) {
        var count=Math.ceil(Math.abs(sweep)/(Math.PI/2)),step=sweep/count,data={vertices:[],inTangents:[],outTangents:[],closed:true};
        function boundary(radius,angle,delta) {
            var offset=data.vertices.length;
            for(var i=0;i<=count;i++) {
                var a=angle+i*delta;
                data.vertices.push([radius*Math.cos(a),radius*Math.sin(a)]);data.inTangents.push([0,0]);data.outTangents.push([0,0]);
            }
            for(i=0;i<count;i++) {
                var p=data.vertices[offset+i],q=data.vertices[offset+i+1],h=4/3*Math.tan(delta/4);
                data.outTangents[offset+i]=[-p[1]*h,p[0]*h];data.inTangents[offset+i+1]=[q[1]*h,-q[0]*h];
            }
        }
        boundary(ro,start,step);boundary(ri,start+sweep,-step);return data;
    }
    // Independent synthetic offset construction, not the recognizer's midpoint solver.
    function polygonOffset(points,distance,closed) {
        var n=points.length,out=[];
        function line(i) {var a=points[i],b=points[(i+1)%n],dx=b[0]-a[0],dy=b[1]-a[1],len=Math.sqrt(dx*dx+dy*dy);return {p:[a[0]-dy/len*distance,a[1]+dx/len*distance],d:[dx/len,dy/len]};}
        for(var i=0;i<n;i++) {
            var next=line(i===n-1 && !closed ? i-1 : i);
            if(!closed && (i===0 || i===n-1)){out.push(i===0 ? next.p : [points[i][0]-next.d[1]*distance,points[i][1]+next.d[0]*distance]);continue;}
            var previous=line((i+n-1)%n),den=previous.d[0]*next.d[1]-previous.d[1]*next.d[0];
            var dx=next.p[0]-previous.p[0],dy=next.p[1]-previous.p[1],t=(dx*next.d[1]-dy*next.d[0])/den;
            out.push([previous.p[0]+t*previous.d[0],previous.p[1]+t*previous.d[1]]);
        }
        return out;
    }
    function polygonFrame(points,width){return {data:straight(polygonOffset(points,-width/2,true)),extraPath:reverse(straight(polygonOffset(points,width/2,true)))};}
    function connector(points,width){return straight(polygonOffset(points,-width/2,false).concat(polygonOffset(points,width/2,false).reverse()));}
    function regular(count,radius){var pts=[];for(var i=0;i<count;i++){var a=-Math.PI/2+i*2*Math.PI/count;pts.push([radius*Math.cos(a),radius*Math.sin(a)]);}return pts;}
    function roundedRect(w,h,r) {
        var x=w/2,y=h/2,k=0.5522847498307936*r;
        return {vertices:[[-x+r,-y],[x-r,-y],[x,-y+r],[x,y-r],[x-r,y],[-x+r,y],[-x,y-r],[-x,-y+r]],
            inTangents:[[-k,0],[0,0],[0,-k],[0,0],[k,0],[0,0],[0,k],[0,0]],
            outTangents:[[0,0],[k,0],[0,0],[0,k],[0,0],[-k,0],[0,0],[0,-k]],closed:true};
    }
    function roundedFrame(w,h,r,width){return {data:roundedRect(w+width,h+width,r+width/2),extraPath:reverse(roundedRect(w-width,h-width,r-width/2))};}
    function roundBand(ro,ri,start,sweep) {
        var result={vertices:[],inTangents:[],outTangents:[],closed:true},radius=(ro+ri)/2,cap=(ro-ri)/2,sign=sweep>0 ? 1 : -1;
        function append(r,center,a,delta) {
            var count=Math.ceil(Math.abs(delta)/(Math.PI/2)),step=delta/count,h=4/3*Math.tan(step/4);
            for(var i=0;i<=count;i++) {
                var angle=a+i*step,v=[center[0]+r*Math.cos(angle),center[1]+r*Math.sin(angle)],incoming=i ? [r*Math.sin(angle)*h,-r*Math.cos(angle)*h] : [0,0],outgoing=i<count ? [-r*Math.sin(angle)*h,r*Math.cos(angle)*h] : [0,0];
                if(i===0 && result.vertices.length){result.outTangents[result.vertices.length-1]=outgoing;continue;}
                result.vertices.push(v);result.inTangents.push(incoming);result.outTangents.push(outgoing);
            }
        }
        append(ro,[0,0],start,sweep);
        append(cap,[radius*Math.cos(start+sweep),radius*Math.sin(start+sweep)],start+sweep,sign*Math.PI);
        append(ri,[0,0],start+sweep,-sweep);
        append(cap,[radius*Math.cos(start),radius*Math.sin(start)],start+sign*Math.PI,sign*Math.PI);
        result.inTangents[0]=result.inTangents.pop();result.vertices.pop();result.outTangents.pop();return result;
    }
    function catalog() {
        var cases=[];
        function add(name,expected,parametric,rounded,angle,nested,options) {cases.push({name:name,expected:expected,parametric:parametric,rounded:rounded,angle:angle,nested:nested,options:options || {}});}
        add("Native horizontal rectangle",true,true,false,0,false);
        add("Native vertical capsule",true,true,true,0,false,{size:[20,200]});
        add("Bezier rectangle 45deg",true,false,false,45,false);
        add("Bezier capsule 25deg",true,false,true,25,false);
        add("Vertical Bezier rectangle",true,false,false,90,false);
        add("Nested mirrored capsule",true,false,true,0,true,{mirror:true});
        add("Thin 2-unit rectangle",true,false,false,0,false,{data:PedroStrokeGeometry.fixture(240,2,false,0,[0,0])});
        add("Thick capsule",true,false,true,0,false,{data:PedroStrokeGeometry.fixture(180,70,true,0,[0,0])});
        add("Short capsule",true,false,true,0,false,{data:PedroStrokeGeometry.fixture(90,70,true,0,[0,0])});
        var eight=PedroStrokeGeometry.fixture(200,20,true,0,[0,0]);
        for(var di=0;di<2;di++) {
            var index=di===0 ? 2 : 6;
            eight.vertices.splice(index,0,eight.vertices[index]);eight.inTangents.splice(index,0,eight.inTangents[index]);
            eight.inTangents[index+1]=[0,0];eight.outTangents.splice(index,0,[0,0]);
        }
        add("Eight-vertex capsule",true,false,true,0,false,{data:eight});
        add("Reversed winding capsule",true,false,true,0,false,{data:reverse(PedroStrokeGeometry.fixture(200,20,true,35,[0,0]))});
        var restarted=PedroStrokeGeometry.fixture(200,20,false,10,[0,0]);
        for(var shift=0;shift<2;shift++) {restarted.vertices.push(restarted.vertices.shift());restarted.inTangents.push(restarted.inTangents.shift());restarted.outTangents.push(restarted.outTangents.shift());}
        add("Rectangle changed first vertex",true,false,false,0,false,{data:restarted});
        add("Triangle",false,false,false,0,false,{data:straight([[-80,60],[0,-80],[80,60]])});
        var star=[];
        for(var i=0;i<10;i++){var a=-Math.PI/2+i*Math.PI/5,r=i%2 ? 35 : 80;star.push([Math.cos(a)*r,Math.sin(a)*r]);}
        add("Star",false,false,false,0,false,{data:straight(star)});
        add("L-shaped outline",true,false,false,0,false,{data:straight([[-70,-70],[-40,-70],[-40,40],[70,40],[70,70],[-70,70]])});
        add("Trapezoid",false,false,false,0,false,{data:straight([[-90,-25],[65,-25],[90,25],[-90,25]])});
        add("Intermediate corner radius",false,true,true,0,false,{roundness:5});
        add("Circle",false,false,false,0,false,{data:ellipse(140,140)});
        add("Ellipse",false,false,false,0,false,{data:ellipse(220,110)});
        add("Ring compound path",true,false,false,0,false,{data:ellipse(160,160),extraPath:reverse(ellipse(110,110))});
        var ro=85,ri=55,k=0.5522847498307936;
        add("Quarter arc band",true,false,false,0,false,{data:{vertices:[[-ro,0],[0,-ro],[0,-ri],[-ri,0]],
            inTangents:[[0,0],[-k*ro,0],[0,0],[0,-k*ri]],outTangents:[[0,-k*ro],[0,0],[-k*ri,0],[0,0]],closed:true}});
        var variable=PedroStrokeGeometry.fixture(200,20,true,0,[0,0]);variable.vertices[3][1]+=8;
        add("Variable-width capsule",false,false,true,0,false,{data:variable});
        var curved=PedroStrokeGeometry.fixture(200,20,true,0,[0,0]);curved.outTangents[1][0]*=2;
        add("Distorted curved outline",false,false,true,0,false,{data:curved});
        add("Even-odd same-winding ring",true,false,false,0,false,{data:ellipse(160,160),extraPath:ellipse(110,110),fillRule:2});
        add("Swapped reversed ring contours",true,false,false,0,false,{data:ellipse(110,110),extraPath:reverse(ellipse(160,160))});
        add("Translated circular ring",true,false,false,0,false,{data:translate(ellipse(180,180),[15,-12]),extraPath:translate(reverse(ellipse(120,120)),[15,-12])});
        add("Thin 2-unit ring",true,false,false,0,false,{data:ellipse(160,160),extraPath:reverse(ellipse(156,156))});
        add("Three-quarter arc",true,false,false,0,false,{data:band(85,55,Math.PI/4,3*Math.PI/2)});
        add("Reversed oblique arc",true,false,false,0,false,{data:reverse(band(85,55,Math.PI/7,Math.PI/3))});
        add("Nested mirrored half arc",true,false,false,0,true,{data:band(85,55,-Math.PI/3,Math.PI),mirror:true});
        add("Non-zero same-winding disk",false,false,false,0,false,{data:ellipse(160,160),extraPath:ellipse(110,110),fillRule:1});
        add("Nonconcentric ring",false,false,false,0,false,{data:ellipse(160,160),extraPath:translate(reverse(ellipse(110,110)),[6,0])});
        add("Elliptical ring",false,false,false,0,false,{data:ellipse(180,120),extraPath:reverse(ellipse(140,80))});
        add("Coincident contours",false,false,false,0,false,{data:ellipse(160,160),extraPath:reverse(ellipse(160,160))});
        var skewed=band(85,55,0,Math.PI/2);skewed.vertices[2][0]+=8;
        add("Nonradial arc end",false,false,false,0,false,{data:skewed});
        var uneven=band(85,55,0,Math.PI);uneven.vertices[4][1]+=9;
        add("Variable-width arc",false,false,false,0,false,{data:uneven});
        var square=[[-70,-70],[70,-70],[70,70],[-70,70]],rectangle=[[-100,-50],[100,-50],[100,50],[-100,50]];
        add("Square frame",true,false,false,0,false,polygonFrame(square,12));
        add("Rectangle frame",true,false,false,0,false,polygonFrame(rectangle,14));
        add("Triangle frame",true,false,false,0,false,polygonFrame(regular(3,85),10));
        add("Diamond frame",true,false,false,0,false,polygonFrame([[0,-85],[90,0],[0,85],[-90,0]],10));
        add("Pentagon frame",true,false,false,0,false,polygonFrame(regular(5,80),10));
        add("Hexagon frame",true,false,false,0,false,polygonFrame(regular(6,80),10));
        add("Octagon frame",true,false,false,0,false,polygonFrame(regular(8,80),10));
        add("Irregular convex frame",true,false,false,0,false,polygonFrame([[-90,-40],[-10,-85],[90,-30],[65,65],[-60,70]],10));
        add("Concave L frame",true,false,false,0,false,polygonFrame([[-80,-80],[-20,-80],[-20,20],[80,20],[80,80],[-80,80]],8));
        add("Star frame",true,false,false,0,false,polygonFrame(star,6));
        add("Rounded rectangle frame",true,false,false,0,false,roundedFrame(200,120,30,12));
        add("Capsule frame",true,false,false,0,false,roundedFrame(200,80,40,12));
        var swapped=polygonFrame(regular(3,85),10),temp=swapped.data;swapped.data=reverse(swapped.extraPath);swapped.extraPath=reverse(temp);
        add("Swapped reversed triangle frame",true,false,false,0,false,swapped);
        var eo=polygonFrame(square,12);eo.extraPath=reverse(eo.extraPath);eo.fillRule=2;
        add("Even-odd square frame",true,false,false,0,false,eo);
        var collinear=polygonFrame(rectangle,14);collinear.data.vertices.splice(1,0,[0,-57]);collinear.data.inTangents.splice(1,0,[0,0]);collinear.data.outTangents.splice(1,0,[0,0]);
        add("Redundant collinear frame vertex",true,false,false,0,false,collinear);
        var handles=polygonFrame(rectangle,14);
        for(var hi=0;hi<4;hi++) {var hj=(hi+1)%4,p=handles.data.vertices[hi],q=handles.data.vertices[hj];handles.data.outTangents[hi]=[(q[0]-p[0])/3,(q[1]-p[1])/3];handles.data.inTangents[hj]=[(p[0]-q[0])/3,(p[1]-q[1])/3];}
        add("Collinear cubic handles frame",true,false,false,0,false,handles);
        var nested=polygonFrame(square,12);nested.mirror=true;
        add("Nested mirrored square frame",true,false,false,0,true,nested);
        add("V connector",true,false,false,0,false,{data:connector([[-80,-60],[0,60],[80,-60]],12)});
        add("Z connector",true,false,false,0,false,{data:connector([[-85,-60],[85,-60],[-85,60],[85,60]],12)});
        add("U connector",true,false,false,0,false,{data:connector([[-75,-65],[-75,65],[75,65],[75,-65]],12)});
        var zig=connector([[-90,-60],[-30,-60],[-30,0],[30,0],[30,60],[90,60]],12);
        add("Reversed zigzag connector",true,false,false,0,false,{data:reverse(zig)});
        var variableFrame=polygonFrame(rectangle,14);variableFrame.extraPath.vertices[1][0]+=5;
        add("Variable-width frame",false,false,false,0,false,variableFrame);
        var same=polygonFrame(square,12);same.extraPath=reverse(same.extraPath);
        add("Same-winding solid square",false,false,false,0,false,same);
        var outside=polygonFrame(square,12);translate(outside.extraPath,[30,0]);
        add("Outside frame hole",false,false,false,0,false,outside);
        var crossing=polygonFrame(square,12),tmp=crossing.data.vertices[1];crossing.data.vertices[1]=crossing.data.vertices[2];crossing.data.vertices[2]=tmp;
        add("Crossed frame contour",false,false,false,0,false,crossing);
        var touching=polygonFrame(square,12);touching.extraPath.vertices[0]=touching.data.vertices[0];
        add("Touching frame contours",false,false,false,0,false,touching);
        var badRound=roundedFrame(200,120,30,12);badRound.data.outTangents[1][0]*=1.05;
        add("Distorted rounded frame",false,false,false,0,false,badRound);
        add("Solid square",false,false,false,0,false,{data:straight(square)});
        add("T junction",false,false,false,0,false,{data:straight([[-80,-70],[80,-70],[80,-50],[10,-50],[10,70],[-10,70],[-10,-50],[-80,-50]])});
        add("Arrow with wide head",false,false,false,0,false,{data:straight([[-90,-10],[40,-10],[40,-35],[90,0],[40,35],[40,10],[-90,10]])});
        var skewConnector=connector([[-75,-70],[-75,60],[75,60]],20);skewConnector.vertices[0][1]+=5;
        add("Skewed connector cap",false,false,false,0,false,{data:skewConnector});
        add("Round-ended quarter arc",true,false,false,0,false,{data:roundBand(85,55,0,Math.PI/2)});
        add("Round-ended three-quarter arc",true,false,false,0,false,{data:roundBand(85,55,Math.PI/7,3*Math.PI/2)});
        add("Reversed round-ended arc",true,false,false,0,false,{data:reverse(roundBand(85,55,Math.PI/7,-Math.PI))});
        add("Overlapping round arc caps",false,false,false,0,false,{data:roundBand(85,55,0,350*Math.PI/180)});
        add("Acute triangle frame",true,false,false,0,false,polygonFrame([[0,-80],[20,80],[-20,80]],10));
        add("Thin 2-unit square frame",true,false,false,0,false,polygonFrame(square,2));
        return cases;
    }
    function fromCase(comp,entry,name) {return source(comp,name || entry.name,entry.parametric,entry.rounded,entry.angle,entry.nested,entry.options);}
    function demo() {
        var entries=catalog(),created=[],ready=null;
        try {
            for(var section=0;section<2;section++) {
                var expected=section===0,total=0;
                for(var ei=0;ei<entries.length;ei++)if(entries[ei].expected===expected)total++;
                var c=app.project.items.addComp("Shape to Stroke v0.0.5 "+(expected ? "READY" : "SKIP")+" "+new Date().getTime(),1200,Math.ceil(total/3)*240+80,1,4,24);
                created.push(c);if(expected)ready=c;var count=0;
                for(var i=0;i<entries.length;i++) if(entries[i].expected===expected) {
                    var name=(count+1<10 ? "0" : "")+(count+1)+" "+(expected ? "READY" : "SKIP")+" - "+entries[i].name;
                    var f=fromCase(c,entries[i],name);
                    f.layer.property("ADBE Transform Group").property("ADBE Position").setValue([200+(count%3)*400,140+Math.floor(count/3)*240]);
                    f.layer.selected=false;count++;
                }
                c.time=0;
            }
            ready.layer(ready.numLayers).selected=true;
            return {comps:created,ready:ready};
        } catch(error) {
            for(var j=created.length-1;j>=0;j--) {try{created[j].remove();}catch(cleanup){}}
            throw error;
        }
    }
    return {source:source,toShape:toShape,catalog:catalog,fromCase:fromCase,demo:demo,ellipse:ellipse,band:band,reverse:reverse,translate:translate,
        polygonFrame:polygonFrame,connector:connector,regular:regular,roundedFrame:roundedFrame,straight:straight,roundBand:roundBand};
}());
