---
interface Props { id: string; label: string; eager?: boolean }
const { id, label, eager = false } = Astro.props;
---
<div class="demo" data-demo>
  <video
    class="demo-video"
    id={`video-${id}`}
    aria-label={label}
    poster={`/media/${id}.png`}
    preload={eager ? 'metadata' : 'none'}
    width="800" height="450" muted loop playsinline controls
  >
    <source src={`/media/${id}.mp4`} type="video/mp4" />
    <a href={`/media/${id}.gif`}>Watch the {id.replaceAll('-', ' ')} demo</a>
  </video>
  <button class="demo-toggle" type="button" aria-controls={`video-${id}`} aria-label="Play demo" hidden>
    <span class="play-symbol" aria-hidden="true">▶</span><span data-play-label>Play demo</span>
  </button>
</div>
