---
import Demo from './Demo.astro';
import { tools } from '../data/tools';
import github from '../data/github.json';
interface Props { tool: (typeof tools)[number]; featured?: boolean }
const { tool, featured = false } = Astro.props;
const base = `${github.repository}/blob/main/`;
---
<article class:list={['tool-card', { featured }]} data-category={tool.category} id={tool.id}>
  <div class:list={['tool-visual', `visual-${tool.id}`]}>
    <div class="visual-meta"><span>{tool.number} / {tool.type}</span><span>FREE TOOL <span aria-hidden="true">↗</span></span></div>
    {tool.demo ? <Demo id={tool.id} label={tool.demoLabel} eager={featured} /> : tool.id === 'font-inspector' ? (
      <div class="font-study" aria-hidden="true"><span class="font-sample">Aa<span class="font-cross">+</span></span><div class="font-study-bottom"><span>Every font.<br/>Every layer.</span><span class="font-outline">Aa</span></div></div>
    ) : (
      <div class="depth-study" aria-hidden="true"><div class="depth-planes"><i></i><i></i><i></i><i></i><i></i></div><div class="depth-legend"><span>NEAR</span><div></div><span>FAR</span></div></div>
    )}
  </div>
  <div class="tool-body">
    <div class="tool-kicker"><span>{tool.category}</span>{tool.badge && <span class:list={['badge', { experimental: tool.badge === 'Experimental' }]}>{tool.badge}</span>}</div>
    <h3>{tool.name}</h3>
    {featured && <p class="feature-headline">{tool.headline}</p>}
    <p class="tool-description">{tool.description}</p>
    <div class="tool-tags">{tool.tags.map(tag => <span>{tag}</span>)}</div>
    <div class="tool-links"><a href={`${base}${tool.guide}`} target="_blank" rel="noreferrer" aria-label={`Read the ${tool.name} guide on GitHub`}>View guide <span aria-hidden="true">↗</span></a><a class="source-link" href={`${github.repository}/${tool.source.endsWith('.jsx') ? 'blob' : 'tree'}/main/${tool.source}`} target="_blank" rel="noreferrer" aria-label={`View ${tool.name} source on GitHub`}>Source <span aria-hidden="true">↗</span></a></div>
  </div>
</article>
