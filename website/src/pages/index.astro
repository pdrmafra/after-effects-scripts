---
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../data/tools';
import github from '../data/github.json';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Transversal — Small tools. More motion.</title>
    <meta name="description" content="Independent tools for your motion-design workflow. Explore free After Effects scripts for keyframes, shapes, fonts and local depth maps, by Pedro Mafra." />
    <meta name="theme-color" content="#F3F1EC" />
    <link rel="preload" href="/fonts/Switzer-Medium.otf" as="font" type="font/otf" crossorigin />
    <link rel="canonical" href="https://transversal.tools/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Transversal — Small tools. More motion." />
    <meta property="og:description" content="A growing collection of free tools, made in the motion-design workflow." />
    <meta property="og:url" content="https://transversal.tools/" />
    <meta property="og:image" content="https://transversal.tools/social-card.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header container">
      <a class="wordmark" href="#" aria-label="Transversal home"><picture><source media="(max-width: 760px)" srcset="/brand/logo-stacked.svg" width="234.29" height="80"/><img src="/brand/logo-horizontal.svg" alt="Transversal Tools" width="352.82" height="80" fetchpriority="high"/></picture></a>
      <nav aria-label="Main navigation"><a href="#freebies">Freebies <span class="nav-count">05</span></a><a href="#getting-started">Getting started</a><a href="#about">About</a></nav>
      <a class="header-github" href={github.repository} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main">
      <section class="hero container" aria-labelledby="hero-title">
        <div class="eyebrow"><span class="status-dot"></span> INDEPENDENT TOOLS FOR MOTION DESIGN</div>
        <div class="hero-title-row"><h1 id="hero-title">Small tools.<br/><span>More motion.</span></h1><div class="motion-mark" aria-hidden="true"><div class="symbol-clearspace"><img src="/brand/symbol.svg" alt="" width="80" height="80"/></div><span>LESS FRICTION / MORE FLOW</span></div></div>
        <div class="hero-bottom"><p>For the little things between an idea<br class="desktop-break"/> and a finished animation.</p><div class="hero-actions"><a class="button button-dark" href="#freebies">Explore the freebies <span aria-hidden="true">↓</span></a><span class="hero-note">Made in the workflow.<br/>Free to make it yours.</span></div></div>
        <div class="hero-foot"><span>AFTER EFFECTS / SCRIPTS & UTILITIES</span><span>BY PEDRO MAFRA <span aria-hidden="true">↙</span></span></div>
      </section>
      <section class="collection container" id="freebies" aria-labelledby="collection-title">
        <div class="section-heading"><div><div class="eyebrow">THE COLLECTION / 001—005</div><h2 id="collection-title">A few useful shortcuts.</h2></div><p>Less time on the repetitive stuff. <br/>More room for the work you love.</p></div>
        <div class="collection-bar"><div class="filters" role="group" aria-label="Filter tools" hidden><button type="button" data-filter="All" aria-pressed="true">All tools <span>05</span></button><button type="button" data-filter="Animation" aria-pressed="false">Animation <span>03</span></button><button type="button" data-filter="Workflow" aria-pressed="false">Workflow <span>01</span></button><button type="button" data-filter="Depth" aria-pressed="false">Depth <span>01</span></button></div><a class="download-link" href={github.downloadUrl}>Download all <span aria-hidden="true">↙</span></a></div>
        <p class="sr-only" role="status" id="filter-status">Showing all 5 tools.</p>
        <div class="tool-grid">{tools.map((tool, i) => <ToolCard tool={tool} featured={i === 0}/>)}</div>
        <div class="collection-note"><span class="status-dot"></span><p>All five tools are in the download bundle. Source code and guides live on GitHub.</p><a href={github.releaseUrl} target="_blank" rel="noreferrer">{github.releaseTag} <span aria-hidden="true">↗</span></a></div>
      </section>
      <section class="getting-started" id="getting-started" aria-labelledby="start-title"><div class="container">
        <div class="section-heading"><div><div class="eyebrow">FROM DOWNLOAD TO TIMELINE</div><h2 id="start-title">Make yourself at home.</h2></div><a class="text-link" href={`${github.repository}#install`} target="_blank" rel="noreferrer">Full installation guide <span aria-hidden="true">↗</span></a></div>
        <div class="steps"><div class="step"><span class="step-number">01</span><h3>Grab the tools.</h3><p>Download the release ZIP and unzip it. Choose the tools that fit your workflow.</p><a href={github.downloadUrl}>Download the bundle <span aria-hidden="true">↙</span></a></div><div class="step"><span class="step-number">02</span><h3>Bring them into AE.</h3><p>For standalone scripts, choose <strong>File → Scripts → Run Script File…</strong> in After Effects.</p><p class="step-note">Keyframe Tools also docks as a ScriptUI panel. Depth Map has its own setup guide.</p></div><div class="step"><span class="step-number">03</span><h3>Find your flow.</h3><p>Try a tool on a saved project. Each guide explains what it does, what it supports and how to use it.</p><a href={`${github.repository}/issues`} target="_blank" rel="noreferrer">Share an idea or report an issue <span aria-hidden="true">↗</span></a></div></div>
        <div class="compatibility"><span class="mono-label">A QUICK NOTE</span><p>Tested on After Effects 26.5 for macOS. Windows and older versions haven’t been tested yet. Depth Map requires macOS, Python 3.12 and additional downloads.</p></div>
      </div></section>
      <section class="about container" id="about" aria-labelledby="about-title"><div class="about-left"><div class="eyebrow">A NOTE FROM THE MAKER</div><h2 id="about-title">Built along<br/>the way<span>.</span></h2></div><div class="about-copy"><p>Transversal is a home for tools that come out of my motion-design workflow. Small experiments, useful shortcuts, and things I wanted to exist.</p><p>I’m Pedro Mafra. I’m sharing these tools so they can find a place in your process, too. Take a look around, try something out, and let me know what you make.</p><a class="text-link" href="https://pedromafra.com" target="_blank" rel="noreferrer">More about my work <span aria-hidden="true">↗</span></a></div></section>
      <section class="closing container" aria-label="Download the free tools"><p>A little less busywork.<br/><span>A little more possibility.</span></p><a class="button button-dark" href={github.downloadUrl}>Get the free tools <span aria-hidden="true">↙</span></a><div class="closing-mark" aria-hidden="true">↗</div></section>
    </main>
    <footer class="site-footer container"><a class="wordmark" href="#" aria-label="Transversal Tools home"><picture><source media="(max-width: 760px)" srcset="/brand/logo-stacked.svg" width="234.29" height="80"/><img src="/brand/logo-horizontal.svg" alt="Transversal Tools" width="352.82" height="80" loading="lazy"/></picture></a><span>INDEPENDENT TOOLS. SHARED FREELY.</span><div><a href={`${github.repository}/blob/main/LICENSE`} target="_blank" rel="noreferrer">MIT license ↗</a><a href={github.repository} target="_blank" rel="noreferrer">GitHub ↗</a></div></footer>
    <script>
      const cards = [...document.querySelectorAll<HTMLElement>('.tool-card')];
      const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
      document.querySelector<HTMLElement>('.filters')!.hidden = false;
      filters.forEach(button => button.addEventListener('click', () => {
        const filter = button.dataset.filter;
        filters.forEach(other => other.setAttribute('aria-pressed', String(other === button)));
        cards.forEach(card => { card.hidden = filter !== 'All' && card.dataset.category !== filter; });
        const count = cards.filter(card => !card.hidden).length;
        document.querySelector('#filter-status')!.textContent = `Showing ${count} ${filter === 'All' ? '' : filter?.toLowerCase() + ' '}tool${count === 1 ? '' : 's'}.`;
        document.querySelector('.tool-grid')!.classList.toggle('filtered', filter !== 'All');
      }));

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const players = [...document.querySelectorAll<HTMLElement>('[data-demo]')];
      players.forEach(player => {
        const video = player.querySelector('video')!;
        const button = player.querySelector<HTMLButtonElement>('button')!;
        const label = button.querySelector('[data-play-label]')!;
        const symbol = button.querySelector('.play-symbol')!;
        let userPaused = false;
        let visible = false;
        video.controls = false;
        button.hidden = false;
        const update = () => {
          label.textContent = video.paused ? 'Play demo' : 'Pause demo';
          symbol.textContent = video.paused ? '▶' : 'Ⅱ';
          button.setAttribute('aria-label', `${video.paused ? 'Play' : 'Pause'} ${player.closest('article')!.querySelector('h3')!.textContent} demo`);
        };
        const play = () => { video.play().catch(update); };
        button.addEventListener('click', () => {
          if (video.paused) { userPaused = false; play(); }
          else { userPaused = true; video.pause(); }
        });
        video.addEventListener('play', update);
        video.addEventListener('pause', update);
        new IntersectionObserver(entries => {
          visible = entries[0].isIntersecting;
          if (visible && !userPaused && !reducedMotion.matches && !document.hidden) play();
          else video.pause();
        }, { threshold: 0.25 }).observe(video);
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) video.pause();
          else if (visible && !userPaused && !reducedMotion.matches) play();
        });
        reducedMotion.addEventListener('change', () => {
          if (reducedMotion.matches) video.pause();
          else if (visible && !userPaused && !document.hidden) play();
        });
        update();
      });
    </script>
  </body>
</html>
